{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": ">=2",
    "@cap-js/mcp": "file:../../",
    "@sap/cds": ">=9",
    "@sap/hana-client": "^2.29.23",
    "@sap/xssec": "^4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2",
    "better-sqlite3": ">=12"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "log": {
      "levels": {
        "sql": "info",
        "cds": "info"
      }
    },
    "mcp": {
      "per_action_tool": false,
      "prefix": false,
      "format": "cql"
    },
    "hana": {
      "fuzzy": false
    },
    "sqlite": {
      "driver": "better-sqlite3"
    },
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "application-logging": true
    },
    "[ias-st]": {
      "protocols": { "mcp": { "auth": { "baseUrl": "<replaced at test start>" }}},
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "ias",
          "credentials": {
            "url": "https://abc.accounts400.ondemand.com"
          },
          "config": {
            "validation": {
              "enabled": false
            }
          }
        }
      }
    },
    "[xsuaa-st]": {
      "protocols": { "mcp": { "auth": { "baseUrl": "<replaced at test start>" }}},
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "xsuaa",
          "credentials": {
            "url": "https://abc.authentication.sap.hana.ondemand.com",
            "clientid": "mock-xsuaa",
            "clientsecret": "mock-secret",
            "xsappname": "bookshop",
            "tenantid": "1"
          },
          "config": {
            "validation": {
              "enabled": false
            }
          }
        }
      }
    },
    "[xsuaa-cert-st]": {
      "protocols": { "mcp": { "auth": { "baseUrl": "<replaced at test start>", "static_client_registration": true }}},
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "xsuaa",
          "credentials": {
            "url": "https://abc.authentication.sap.hana.ondemand.com",
            "clientid": "mock-xsuaa",
            "key": "mock-key",
            "certificate": "mock-cert",
            "xsappname": "bookshop",
            "tenantid": "1"
          },
          "config": {
            "validation": {
              "enabled": false
            }
          }
        }
      }
    }
  }
}
