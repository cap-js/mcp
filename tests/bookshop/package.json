{
  "name": "bookshop",
  "version": "1.0.0",
  "private": true,
  "description": "A simple CAP project.",
  "scripts": {
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/hana": ">=2",
    "@cap-js/mcp": "file:../../",
    "@sap/cds": ">=9",
    "@sap/hana-client": "^2.29.23",
    "@sap/xssec": "^4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2",
    "better-sqlite3": ">=12"
  },
  "cds": {
    "log": {
      "levels": {
        "sql": "info",
        "cds": "info"
      }
    },
    "mcp": {
      "per_action_tool": false,
      "prefix": false,
      "format": "cql"
    },
    "hana": {
      "fuzzy": false
    },
    "sqlite": {
      "driver": "better-sqlite3"
    },
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "application-logging": true
    }
  }
}
